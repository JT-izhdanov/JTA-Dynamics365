# --- Customer configuration and data: NEVER commit -------------------------
# Only customer.example.yaml (placeholders) belongs in this repository.
platform/config/*.yaml
!platform/config/customer.example.yaml
platform/config/*.yml
!platform/config/customer.example.yml

# Any engagement-specific or customer-named material
**/customer/
**/customers/
**/engagement/
**/engagements/
*-customer.*
*.customer.*

# --- Environment identifiers -----------------------------------------------
# Workspace / lakehouse / capacity IDs and deep links stay out of version control.
# Committed template: docs/architecture/fabric-workspaces.local.example.md
*.local.md
!*.local.example.md

# --- Secrets ---------------------------------------------------------------
.env
.env.*
*.pfx
*.key
*.pem
*.p12
secrets.*
*secret*
*credential*
appsettings.*.json
!appsettings.example.json

# --- Data extracts: no customer data, ever ---------------------------------
*.csv
*.tsv
*.parquet
*.xlsx
*.xls
data/
extracts/
exports/

# Narrow exception: DE-IDENTIFIED Bronze samples only.
# These are SYNTHESISED from a documented profile, not masked exports — the generators
# take no real data as input. See docs/bronze-profiling/samples/README.md.
# Nothing else under any samples/ directory is exempt; add files here one at a time,
# never a wildcard, and never a real export.
!docs/bronze-profiling/samples/*.sample.tsv
!docs/bronze-profiling/samples/*.sample.csv

# --- Power BI --------------------------------------------------------------
# Binary .pbix defeats source control. Commit PBIP/TMDL instead — see packs/README.md
*.pbix
*.pbit
# Power BI / Fabric local caches
.pbi/
*.abf

# --- Notebook output ------------------------------------------------------
# Output can contain customer data. Commit notebooks with output cleared.
*.ipynb_checkpoints
.ipynb_checkpoints/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Office temp files ----------------------------------------------------
~$*
